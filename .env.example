# ==============================================================================
# Sewa Setu — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env for local development:
#    cp .env.example .env
# 2. Update placeholders with environment-appropriate values.
# 3. In production, set APP_ENV=production. Any missing or insecure default secrets
#    will cause an immediate fatal startup failure.
# 4. NEVER commit your populated .env file to version control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Flask Secret Key
# In production, generate a secure 64-character hex key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-flask-secret-key-change-in-production

# Administrative Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-password-change-in-production

# PostgreSQL Database Configuration
POSTGRES_DB=sewasetu
POSTGRES_USER=sewasetu
POSTGRES_PASSWORD=dev-db-password-change-in-production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sewasetu
DB_USER=sewasetu
DB_PASSWORD=dev-db-password-change-in-production

# Simulated SMS Gateway Service URL
SMS_GATEWAY_URL=http://localhost:8025

# Dedicated Telecom Gateway Auth Token (Production Security)
# In production, /__gateway/ diagnostic console and API are closed by default.
# Supply an independent secret token here to authorize evaluation probes (never share with admin credentials).
GATEWAY_AUTH_TOKEN=dev-gateway-auth-token-optional-in-dev

# Pension Statutory Parameters
PENSION_MIN_AGE=60
PENSION_SLA_DAYS=15
PENSION_SCHEME_DEADLINE=2026-10-31 23:59

